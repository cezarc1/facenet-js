{
  "name": "facenet-js",
  "version": "0.1.2",
  "description": "Face detection and recognition library using MediaPipe with helpful React hooks and components",
  "author": "Cezar Cocu <me@cezarcocu.com>",
  "license": "MIT",
  "keywords": [
    "face-detection",
    "face-recognition",
    "mediapipe",
    "computer-vision",
    "facenet",
    "face-embeddings"
  ],
  "homepage": "https://github.com/cezarc1/facenet-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cezarc1/facenet-js.git"
  },
  "bugs": {
    "url": "https://github.com/cezarc1/facenet-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "vite build",
    "build:cjs": "vite build --config vite.config.cjs.ts",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap && node scripts/fix-declarations.mjs",
    "clean": "rm -rf dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:src",
    "lint:src": "eslint .",
    "lint:examples": "npm --prefix examples run lint",
    "lint:package": "publint && node scripts/verify-pack.mjs",
    "lint:types": "attw --pack .",
    "lint:deps": "knip --no-config-hints",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "release:verify": "npm run build && npm run lint:package && npm run lint:types",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:package && npm run lint:types && npm run lint:deps && npm run lint:examples && npm --prefix examples run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "density-clustering": "^1.3.0",
    "ml-hclust": "^3.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/density-clustering": "^1.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "knip": "^6.17.1",
    "prettier": "^3.3.3",
    "publint": "^0.3.21",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.61.1",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "browserslist": {
    "modern": [
      "Chrome >= 121",
      "Edge >= 121",
      "Firefox >= 121",
      "Safari >= 17.4"
    ]
  }
}
